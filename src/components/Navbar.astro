---
// Navbar.astro
---

<header class="fixed w-full top-0 z-50 bg-terahome-navy text-terahome-white shadow-md border-b border-terahome-blue">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="#hero" class="text-2xl font-bold font-heading text-terahome-white flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-terahome-lightgreen">
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          Terahome
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8">
        <a href="#hero" class="text-terahome-white hover:text-terahome-lightgreen transition-colors font-medium">Home</a>
        <a href="#paket" class="text-terahome-white hover:text-terahome-lightgreen transition-colors font-medium">Paket Internet</a>
        <a href="#keunggulan" class="text-terahome-white hover:text-terahome-lightgreen transition-colors font-medium">Keunggulan</a>
        <a href="#tentang" class="text-terahome-white hover:text-terahome-lightgreen transition-colors font-medium">Tentang Kami</a>
        <a href="#kontak" class="text-terahome-white hover:text-terahome-lightgreen transition-colors font-medium">Kontak</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center">
        <a href="#paket" class="bg-terahome-green hover:bg-terahome-darkgreen text-terahome-white px-6 py-2.5 rounded-md font-semibold transition-colors shadow-sm">
          Berlangganan
        </a>
      </div>

      <!-- Mobile menu button (visual only for now as JS is minimized) -->
      <div class="md:hidden flex items-center">
        <button type="button" class="text-terahome-white hover:text-terahome-lightgreen focus:outline-none" aria-label="Menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
