---
// About.astro
---

<section id="tentang" class="py-20 md:py-28 bg-terahome-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      
      <!-- Visual / Metrics -->
      <div class="md:w-1/2 w-full grid grid-cols-2 gap-4">
        <div class="bg-terahome-offwhite p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col justify-center items-center text-center aspect-square">
          <div class="text-4xl md:text-5xl font-bold text-terahome-green mb-2">100%</div>
          <div class="text-terahome-navy font-semibold">Fokus Kualitas</div>
        </div>
        <div class="bg-terahome-navy p-8 rounded-xl shadow-sm text-terahome-white flex flex-col justify-center items-center text-center aspect-square transform md:translate-y-8">
          <div class="text-4xl md:text-5xl font-bold text-terahome-lightgreen mb-2">24/7</div>
          <div class="font-semibold">Support</div>
        </div>
      </div>
      
      <!-- Text Content -->
      <div class="md:w-1/2">
        <h2 class="text-3xl md:text-4xl font-bold text-terahome-navy mb-6 leading-tight">
          Terhubung Lebih Baik Bersama Terahome
        </h2>
        
        <p class="text-lg text-terahome-dark/80 mb-8 leading-relaxed">
          Terahome provides home internet services intended to support everyday digital activities for families.
        </p>
        
        <ul class="space-y-4">
          <li class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-terahome-offwhite flex items-center justify-center text-terahome-green shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-terahome-navy font-semibold text-lg">Stabil</span>
          </li>
          <li class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-terahome-offwhite flex items-center justify-center text-terahome-green shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-terahome-navy font-semibold text-lg">Terjangkau</span>
          </li>
          <li class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-terahome-offwhite flex items-center justify-center text-terahome-green shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-terahome-navy font-semibold text-lg">Terpercaya</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
