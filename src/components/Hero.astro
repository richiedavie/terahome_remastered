---
// Hero.astro
---

<section id="hero" class="pt-32 pb-20 md:pt-40 md:pb-28 bg-terahome-offwhite">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-8">
      
      <!-- Text Content -->
      <div class="md:w-1/2 flex flex-col items-start text-left">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-terahome-navy leading-tight mb-6">
          Internet Cepat.<br/>
          <span class="text-terahome-green">Hidup Tanpa Batas.</span>
        </h1>
        
        <p class="text-lg md:text-xl text-terahome-dark/80 mb-8 max-w-lg leading-relaxed">
          Internet rumah cepat, stabil, dan terpercaya untuk kebutuhan sehari-hari. Nikmati koneksi tanpa hambatan bersama Terahome.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 mb-10 w-full sm:w-auto">
          <a href="#paket" class="bg-terahome-green hover:bg-terahome-darkgreen text-terahome-white px-8 py-3.5 rounded-md font-semibold text-center transition-colors shadow-sm">
            Lihat Paket Internet
          </a>
          <a href="#kontak" class="border-2 border-terahome-navy text-terahome-navy hover:bg-terahome-navy hover:text-terahome-white px-8 py-3.5 rounded-md font-semibold text-center transition-colors">
            Hubungi Kami
          </a>
        </div>
        
        <!-- Trust Indicators -->
        <div class="flex items-center gap-6 text-sm font-medium text-terahome-navy">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-terahome-lightgreen" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Cepat & Stabil
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-terahome-lightgreen" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Unlimited
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-terahome-lightgreen" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Support 24/7
          </div>
        </div>
      </div>
      
      <!-- Visual -->
      <div class="md:w-1/2 flex justify-center w-full">
        <div class="relative w-full max-w-md aspect-square bg-terahome-navy rounded-2xl flex items-center justify-center p-8 shadow-xl">
          <div class="absolute inset-0 border-2 border-terahome-blue rounded-2xl m-4 opacity-50"></div>
          
          <!-- Abstract Router Concept -->
          <div class="bg-terahome-white rounded-lg p-6 shadow-lg w-full z-10 flex flex-col items-center">
            <div class="flex gap-3 mb-6">
              <div class="w-2 h-12 bg-terahome-lightgreen rounded-t-full"></div>
              <div class="w-2 h-16 bg-terahome-lightgreen rounded-t-full transform -translate-y-2"></div>
              <div class="w-2 h-12 bg-terahome-lightgreen rounded-t-full"></div>
            </div>
            <div class="w-full h-16 bg-terahome-navy rounded-md flex items-center justify-around px-4">
              <div class="w-3 h-3 rounded-full bg-terahome-lightgreen animate-pulse"></div>
              <div class="w-3 h-3 rounded-full bg-terahome-lightgreen animate-pulse" style="animation-delay: 200ms"></div>
              <div class="w-3 h-3 rounded-full bg-terahome-lightgreen animate-pulse" style="animation-delay: 400ms"></div>
            </div>
            <div class="mt-4 font-heading font-bold text-terahome-navy text-xl">TERAHOME</div>
          </div>
          
        </div>
      </div>
      
    </div>
  </div>
</section>
