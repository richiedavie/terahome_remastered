---
// Advantages.astro
---

<section id="keunggulan" class="py-20 md:py-28 bg-terahome-offwhite">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-terahome-navy mb-4">Keunggulan Terahome</h2>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Feature 1 -->
      <div class="bg-terahome-white p-8 rounded-xl shadow-sm border border-gray-100">
        <div class="w-14 h-14 bg-terahome-navy text-terahome-white rounded-lg flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-terahome-navy mb-3">Gaming & Streaming</h3>
        <p class="text-terahome-dark/80 text-sm leading-relaxed">
          Nikmati pengalaman bermain game dan streaming video tanpa lag.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-terahome-white p-8 rounded-xl shadow-sm border border-gray-100">
        <div class="w-14 h-14 bg-terahome-navy text-terahome-white rounded-lg flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-terahome-navy mb-3">Low Latency</h3>
        <p class="text-terahome-dark/80 text-sm leading-relaxed">
          Ping rendah untuk respons yang cepat dalam setiap aktivitas online.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-terahome-white p-8 rounded-xl shadow-sm border border-gray-100">
        <div class="w-14 h-14 bg-terahome-navy text-terahome-white rounded-lg flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-terahome-navy mb-3">Coverage Luas</h3>
        <p class="text-terahome-dark/80 text-sm leading-relaxed">
          Jangkauan sinyal yang kuat dan luas ke seluruh area rumah Anda.
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="bg-terahome-white p-8 rounded-xl shadow-sm border border-gray-100">
        <div class="w-14 h-14 bg-terahome-navy text-terahome-white rounded-lg flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-terahome-navy mb-3">Support 24/7</h3>
        <p class="text-terahome-dark/80 text-sm leading-relaxed">
          Tim bantuan siap melayani Anda kapan saja dibutuhkan.
        </p>
      </div>

    </div>
  </div>
</section>
