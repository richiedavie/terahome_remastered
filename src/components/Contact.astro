---
// Contact.astro
---

<section id="kontak" class="py-20 md:py-28 bg-terahome-offwhite">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
      
      <!-- Contact Info -->
      <div class="lg:w-5/12">
        <h2 class="text-3xl md:text-4xl font-bold text-terahome-navy mb-6">Butuh Bantuan?</h2>
        <p class="text-lg text-terahome-dark/80 mb-10 leading-relaxed">
          Hubungi tim Terahome untuk informasi paket, pendaftaran layanan, atau bantuan teknis seputar koneksi internet Anda.
        </p>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-terahome-white shadow-sm flex items-center justify-center text-terahome-green shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-medium text-terahome-dark/60 mb-1">WhatsApp</h4>
              <p class="text-lg font-bold text-terahome-navy">+62 838-2543-0327</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-terahome-white shadow-sm flex items-center justify-center text-terahome-green shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-medium text-terahome-dark/60 mb-1">Website</h4>
              <p class="text-lg font-bold text-terahome-navy">terahome.id</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-terahome-white shadow-sm flex items-center justify-center text-terahome-green shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-medium text-terahome-dark/60 mb-1">Support</h4>
              <p class="text-lg font-bold text-terahome-navy">24/7 Support</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="lg:w-7/12 w-full">
        <div class="bg-terahome-white p-8 md:p-10 rounded-2xl shadow-sm border border-gray-100">
          <form class="space-y-6" onsubmit="event.preventDefault(); alert('Terima kasih! Pesan demo Anda telah terkirim.');">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="nama" class="block text-sm font-medium text-terahome-navy mb-2">Nama</label>
                <input type="text" id="nama" name="nama" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-terahome-green focus:border-transparent bg-terahome-offwhite/50" placeholder="Nama Lengkap">
              </div>
              
              <div>
                <label for="whatsapp" class="block text-sm font-medium text-terahome-navy mb-2">WhatsApp</label>
                <input type="tel" id="whatsapp" name="whatsapp" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-terahome-green focus:border-transparent bg-terahome-offwhite/50" placeholder="08xxxxxxxxxx">
              </div>
            </div>
            
            <div>
              <label for="paket" class="block text-sm font-medium text-terahome-navy mb-2">Pilih Paket (Opsional)</label>
              <select id="paket" name="paket" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-terahome-green focus:border-transparent bg-terahome-offwhite/50">
                <option value="">Pilih paket internet...</option>
                <option value="5mbps">5 Mbps - Rp 155k</option>
                <option value="10mbps">10 Mbps - Rp 195k</option>
                <option value="20mbps">20 Mbps - Rp 220k</option>
                <option value="30mbps">30 Mbps - Rp 250k</option>
                <option value="50mbps">50 Mbps - Rp 350k</option>
                <option value="100mbps">100 Mbps - Rp 400k</option>
              </select>
            </div>
            
            <div>
              <label for="pesan" class="block text-sm font-medium text-terahome-navy mb-2">Pesan</label>
              <textarea id="pesan" name="pesan" rows="4" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-terahome-green focus:border-transparent bg-terahome-offwhite/50 resize-none" placeholder="Tuliskan pesan atau pertanyaan Anda di sini..."></textarea>
            </div>
            
            <button type="submit" class="w-full bg-terahome-green hover:bg-terahome-darkgreen text-terahome-white py-3.5 rounded-lg font-bold text-lg transition-colors shadow-sm">
              Kirim Pesan
            </button>
            
          </form>
        </div>
      </div>
      
    </div>
  </div>
</section>
