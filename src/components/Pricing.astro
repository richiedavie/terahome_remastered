---
// Pricing.astro
import PricingCard from './PricingCard.astro';

const packages = [
  {
    name: 'Essential', speed: '5 Mbps', price: 'Rp 155k',
    feature1: 'Kecepatan hingga 5 Mbps',
    feature2: 'Unlimited Tanpa Batas Kuota',
    feature3: 'Cocok untuk 1–2 Perangkat',
    feature4: 'Browsing & Media Sosial',
    feature5: 'Belajar Online & Video Call',
    feature6: 'Dukungan Pelanggan 24/7',
  },
  {
    name: 'Starter', speed: '10 Mbps', price: 'Rp 195k',
    feature1: 'Kecepatan hingga 10 Mbps',
    feature2: 'Unlimited Tanpa FUP',
    feature3: 'Cocok untuk 3–5 Perangkat',
    feature4: 'Streaming HD Lebih Nyaman',
    feature5: 'Mendukung WFH & Belajar',
    feature6: 'Dukungan Pelanggan 24/7',
  },
  {
    name: 'Family', speed: '20 Mbps', price: 'Rp 220k',
    feature1: 'Kecepatan hingga 20 Mbps',
    feature2: 'Unlimited untuk Aktivitas Harian',
    feature3: 'Cocok untuk 5–8 Perangkat',
    feature4: 'Streaming HD & Video Call',
    feature5: 'Multi-Device Lebih Nyaman',
    feature6: 'Teknisi Siap Membantu',
  },
  {
    name: 'Entertainment', speed: '30 Mbps', price: 'Rp 250k', popular: true,
    feature1: 'Kecepatan hingga 30 Mbps',
    feature2: 'Gaming & Streaming Lebih Lancar',
    feature3: 'Low Latency untuk Gaming',
    feature4: 'Cocok untuk 8–10 Perangkat',
    feature5: 'Gratis Pemasangan Router Wi-Fi',
    feature6: 'Dukungan Teknis 24/7',
  },
  {
    name: 'Pro', speed: '50 Mbps', price: 'Rp 350k',
    feature1: 'Kecepatan hingga 50 Mbps',
    feature2: 'Gaming, Streaming & Download Intensif',
    feature3: 'Upload & Download Lebih Seimbang',
    feature4: 'Mendukung Banyak Perangkat Aktif',
    feature5: 'Gratis Pemasangan Router Wi-Fi',
    feature6: 'Prioritas Dukungan Teknis',
  },
  {
    name: 'Ultimate', speed: '100 Mbps', price: 'Rp 400k',
    feature1: 'Kecepatan hingga 100 Mbps',
    feature2: 'Performa Tinggi untuk Banyak Perangkat',
    feature3: '4K Streaming & Gaming Intensif',
    feature4: 'Mendukung Aktivitas Digital Berat',
    feature5: 'Gratis Pemasangan Router Wi-Fi',
    feature6: 'Prioritas Dukungan Teknis 24/7',
  },
];
---

<section id="paket" class="py-20 md:py-28 bg-terahome-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-terahome-navy mb-4">Pilih Paket Internet Terbaik Untuk Anda</h2>
      <p class="text-lg text-terahome-dark/80">Temukan paket internet yang sesuai dengan kebutuhan rumah Anda.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {packages.map((pkg) => (
        <PricingCard 
          name={pkg.name}
          speed={pkg.speed} 
          price={pkg.price} 
          popular={pkg.popular} 
          feature1={pkg.feature1}
          feature2={pkg.feature2}
          feature3={pkg.feature3}
          feature4={pkg.feature4}
          feature5={pkg.feature5}
          feature6={pkg.feature6}
        />
      ))}
    </div>
  </div>
</section>
